# =============================================================================
# CONFIGURACION DEL SERVIDOR AUTOMATIZACION OS GHA (NODE.JS & EXPRESS)
# =============================================================================

# Puerto del servidor web / API
PORT=3080
HOST=0.0.0.0
NODE_ENV=production

# Seguridad de Sesión y Orígenes Permitidos (CORS)
SESSION_SECRET=reemplazar_por_secreto_aleatorio_de_64_caracteres_en_produccion
SESSION_MAX_AGE_MS=28800000
ALLOWED_ORIGINS=https://automatizacion-os-gha.netlify.app,http://localhost:3080,http://127.0.0.1:3080

# Base de Datos Azure SQL (SIO) - Requeridas al arranque
DB_SERVER=tu_servidor.database.windows.net
DB_PORT=1433
DB_NAME=SIO
DB_USER=tu_usuario_sql
DB_PASSWORD=tu_password_sql_seguro
DB_ENCRYPT=true
DB_TRUST_SERVER_CERTIFICATE=false
DB_CONNECTION_TIMEOUT=30000
DB_REQUEST_TIMEOUT=180000

# Directorio de Informacion (Donde se guardan los archivos HTML de la OS generada)
INFORMACION_DIR=../Informacion

# Control de apagado automatico (false para servidores en produccion)
ALLOW_SHUTDOWN=false

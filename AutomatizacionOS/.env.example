# =============================================================================
# CONFIGURACION DEL SERVIDOR AUTOMATIZACION OS GHA (NODE.JS & EXPRESS)
# =============================================================================

# Puerto del servidor web / API
PORT=3080
HOST=0.0.0.0
NODE_ENV=production

# Base de Datos Azure SQL (SIO)
DB_SERVER=mysqullaats23.database.windows.net
DB_PORT=1433
DB_NAME=SIO
DB_USER=LaatsBdAD
DB_PASSWORD=AndresRivera!9710
DB_ENCRYPT=true
DB_TRUST_SERVER_CERTIFICATE=false
DB_CONNECTION_TIMEOUT=30000
DB_REQUEST_TIMEOUT=180000

# Directorio de Informacion (Donde se guardan los archivos HTML de la OS generada)
# Ruta relativa a la raiz del proyecto o ruta absoluta
INFORMACION_DIR=../Informacion

# Control de apagado automatico (false para servidores en produccion / true solo para pruebas locales)
ALLOW_SHUTDOWN=false

# -----------------------------------------------------------------------------
# CONFIGURACION DE CORREO ELECTRONICO (NOTIFICACIONES EJECUTIVAS)
# -----------------------------------------------------------------------------
# Metodo de envio: 'smtp' o 'outlook' (outlook requiere PowerShell en Windows)
MAIL_METHOD=smtp

# Configuracion SMTP (Para Office 365, Exchange o servidor SMTP corporativo)
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=notificaciones@laats.net
SMTP_PASS=tu_password_aqui
SMTP_FROM="Sistema SIO GHA" <notificaciones@laats.net>

# Destinatarios predeterminados para notificaciones de OS (separados por coma o punto y coma)
MAIL_DEFAULT_RECIPIENTS=programadorit@laats.net, monicaaracely@laats.net, facturacion@laats.net

